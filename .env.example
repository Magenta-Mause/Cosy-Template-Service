# Cosy-Template-Service environment variables
#
# Copy this file to `.env` (it is git-ignored) or set these variables in your
# environment / deployment. These override the matching top-level keys in
# config.yaml at startup. The nested `github.*` keys (owner, repo, ref, path,
# gamesPath) have no usable environment equivalent and must be set in
# config.yaml — `github.token` works only because it is explicitly bound.

# GitHub personal access token used to authenticate calls to the GitHub API.
# Optional: without it the service falls back to an unauthenticated client with
# significantly lower rate limits. A read-only, public-repo token is sufficient
# for the default (public) Cosy-Templates repository.
GITHUB_TOKEN=

# HTTP port the service listens on. Overrides the `port` key in config.yaml.
# PORT=8080

# Gin run mode. The binary starts in `debug`; use `release` in production.
# GIN_MODE=release
