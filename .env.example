# Cosy-Template-Service environment variables
#
# Copy this file to `.env` (it is git-ignored) or set these variables in your
# environment / deployment. All values here override the matching keys in
# config.yaml at startup.

# GitHub personal access token used to authenticate calls to the GitHub API.
# Optional: without it the service falls back to an unauthenticated client with
# significantly lower rate limits. A read-only, public-repo token is sufficient
# for the default (public) Cosy-Templates repository.
GITHUB_TOKEN=
